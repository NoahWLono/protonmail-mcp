# Copy the IMAP values from Proton Mail Bridge -> Mailbox details.
# IMPORTANT: use the password generated by Bridge, not your Proton Account password.
PROTON_BRIDGE_HOST=127.0.0.1
PROTON_BRIDGE_PORT=1143
PROTON_BRIDGE_USERNAME=you@example.com
PROTON_BRIDGE_PASSWORD=replace-with-bridge-generated-password

# Proton Bridge normally uses STARTTLS or SSL with a locally generated self-signed cert.
# Allowed: starttls, ssl, plain
PROTON_BRIDGE_SECURITY=starttls

# Leave TLS verification off for the default localhost Bridge self-signed certificate.
# If you explicitly configure a trusted certificate, set this to 1.
PROTON_BRIDGE_VERIFY_TLS=0

# Safety rail: non-loopback IMAP targets are blocked unless explicitly opted in.
PROTON_MCP_ALLOW_NONLOCAL_IMAP=0

# MCP HTTP server. The project intentionally binds only to loopback.
PROTON_MCP_BIND_HOST=127.0.0.1
PROTON_MCP_PORT=8765

# Data-minimization limits.
PROTON_MCP_MAX_MESSAGE_BYTES=10485760
PROTON_MCP_MAX_BODY_CHARS=50000
PROTON_MCP_MAX_SEARCH_LIMIT=50
PROTON_MCP_SNIPPET_CHARS=1200
PROTON_MCP_SNIPPET_FETCH_BYTES=16000
PROTON_MCP_MAX_MAILBOXES=50
